# Copy to .env and fill in. .env is git-ignored.
DB_NAME=drupal
DB_USER=drupal
# openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=
# openssl rand -base64 48
HASH_SALT=
# Regex list, comma-separated. Production: ^cms\.storyheroapp\.com$
TRUSTED_HOSTS=^localhost$
HTTP_PORT=8080
# Folder with Imagine content (same layout as imagine/content). Full set: ~/Developer/imagine/content
IMAGINE_SOURCE=./source-sample
# On a Mac, Docker Desktop maps file ownership itself; 1000 matches azureuser on the VM.
UID=1000
GID=1000
